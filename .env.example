# Copie para .env.local (desenvolvimento) ou cadastre na Vercel
# (Project → Settings → Environment Variables). Todas são opcionais.

# URL pública do site, sem barra no final. Se vazio, usa src/content/site.ts.
NEXT_PUBLIC_SITE_URL=

# Endpoint que recebe o formulário de contato (POST com JSON).
# Formspree: crie um formulário em formspree.io e cole a URL, ex.:
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
# Se vazio, o formulário exibe aviso neutro pedindo contato por telefone/e-mail.
NEXT_PUBLIC_FORM_ENDPOINT=

# Medição de audiência (opcional). Vazio = sem analytics e sem banner de cookies.
# Google Analytics 4, ex.: G-XXXXXXXXXX (só carrega após o aceite do visitante).
NEXT_PUBLIC_GA_ID=
